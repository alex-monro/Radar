# Copy this file to .env.local and fill in your own keys.

# AI summary of the scan results
OPENAI_API_KEY=

# Google PageSpeed accessibility score
PAGESPEED_API_KEY=

# Remote browser that loads and scans the page
HYPERBROWSER_API_KEY=

# Rate limiting (daily scan limit per visitor)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
