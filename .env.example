# Copy this file to .env.local and fill in your own keys.
# Every key is required except PAGESPEED_API_KEY: without it a scan returns 500.

# Remote browser that loads and scans the page. Required.
HYPERBROWSER_API_KEY=

# AI summary of the scan results. Required (any scan that finds issues calls it).
OPENAI_API_KEY=

# Rate limiting (daily scan limit per visitor). Required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google PageSpeed accessibility score. Optional: without it, Radar's own
# severity-weighted score is used instead.
PAGESPEED_API_KEY=
